#. Plugin Name of the plugin
#: zinn-migrate.php
msgid "Zinn® Migrate"
msgstr "Zinn® Migrate"

#. Plugin URI of the plugin
#: zinn-migrate.php
msgid "https://zinndigital.com/wordpress-plugins/zinn-migrate"
msgstr "https://zinndigital.com/wordpress-plugins/zinn-migrate"

#. Description of the plugin
#: zinn-migrate.php
msgid "Packages this WordPress site — files and database — into one archive that Zinn Digital® can pull in, for hosts we cannot reach any other way. Install it on the site you are LEAVING, press one button, and paste the link into your Zinn® migration."
msgstr "ຫຸ້ມຫໍ່ເວັບໄຊ WordPress ນີ້ — ໄຟລ໌ ແລະ ຖານຂໍ້ມູນ — ເປັນໄຟລ໌ຈັດເກັບດຽວທີ່ Zinn Digital® ສາມາດດຶງເຂົ້າມາໄດ້, ສຳລັບໂຮສຕິງທີ່ພວກເຮົາບໍ່ສາມາດເຂົ້າເຖິງດ້ວຍວິທີອື່ນ. ຕິດຕັ້ງມັນໄວ້ໃນເວັບໄຊທີ່ທ່ານກຳລັງຈະອອກ, ກົດປຸ່ມໜຶ່ງປຸ່ມ, ແລະ ວາງລິ້ງໃສ່ໃນການຍ້າຍຂໍ້ມູນ Zinn® ຂອງທ່ານ."

#. Author of the plugin
#: zinn-migrate.php
msgid "Neil Lock — CEO, Zinn Digital® Ltd"
msgstr "Neil Lock — CEO, Zinn Digital® Ltd"

#. Author URI of the plugin
#: zinn-migrate.php
msgid "https://zinndigital.com"
msgstr "https://zinndigital.com"

#: includes/class-zinn-migrate-admin.php:57
#: includes/class-zinn-migrate-admin.php:150
msgid "Move this site to Zinn®"
msgstr "ຍ້າຍເວັບໄຊນີ້ໄປຍັງ Zinn®"

#: includes/class-zinn-migrate-admin.php:58
msgid "Move to Zinn®"
msgstr "ຍ້າຍໄປທີ່ Zinn®"

#: includes/class-zinn-migrate-admin.php:68
msgid "You do not have permission to do this."
msgstr "ທ່ານບໍ່ມີສິດທິບຳນານໃນການດຳເນີນການນີ້."

#: includes/class-zinn-migrate-admin.php:154
msgid "This packages everything on this site — its files and its database — into one archive, and gives you a private link to it. Paste that link into your migration on Zinn® and we will pull the site across. Nothing here is sent anywhere until you choose to share the link."
msgstr "ພັກເກັດນີ້ລວມທຸກຢ່າງໃນເວັບໄຊນີ້—ທັງໄຟລ໌ ແລະ ຖານຂໍ້ມູນ—ລົງໃນບ່ອນເກັບມ້ຽນດຽວ, ແລະ ໃຫ້ລິ້ງສ່ວນຕົວສຳລັບອັນນັ້ນແກ່ທ່ານ. ວາງລິ້ງນັ້ນລົງໃນການຍ້າຍຂອງທ່ານໃນ Zinn® ແລ້ວພວກພວກເຮົາຈະດຶງເວັບໄຊເຂົ້າມາ. ບໍ່ມີຫຍັງຢູ່ບ່ອນນີ້ຖືກສົ່ງໄປໃສເລີຍຈົນກວ່າທ່ານຈະເລືອກແບ່ງປັນລິ້ງນັ້ນ."

#: includes/class-zinn-migrate-admin.php:168
msgid "You may not need this. If your old host gives you FTP, SSH, cPanel, Plesk or DirectAdmin, Zinn® can fetch the site directly with those details and you can skip this plugin entirely — it is faster and there is nothing left behind afterwards. Use this when none of those are available to you."
msgstr "ທ່ານອາດຈະບໍ່ຈຳເປັນຕ້ອງໃຊ້ສິ່ງນີ້. ຖ້າຜູ້ໃຫ້ບໍລິການໂຮສຕິ້ງເກົ່າຂອງທ່ານໃຫ້ FTP, SSH, cPanel, Plesk ຫຼື DirectAdmin ແກ່ທ່ານ, Zinn® ສາມາດດຶງຂໍ້ມູນເວັບໄຊໄດ້ໂດຍກົງດ້ວຍລາຍລະອຽດເຫຼົ່ານັ້ນ ແລະ ທ່ານສາມາດຂ້າມປລັກອິນນີ້ໄປໄດ້ເລີຍ — ມັນໄວກວ່າ ແລະ ບໍ່ມີຫຍັງຕົກຄ້າງໄວ້ທາງຫຼັງໃນພາຍຫຼັງ. ໃຫ້ໃຊ້ສິ່ງນີ້ເມື່ອບໍ່ມີຕົວເລືອກເຫຼົ່ານັ້ນໃຫ້ທ່ານໃຊ້ງານ."

#: includes/class-zinn-migrate-admin.php:180
msgid "Room on this server"
msgstr "ເນື້ອທີ່ຫວ່າງໃນເຊີບເວີນີ້"

#. translators: %s: an approximate size, e.g. "1.4 GB".
#: includes/class-zinn-migrate-admin.php:191
#, php-format
msgid "This server will not tell us how much disk space is free, so we cannot check for you. The package needs roughly %s. If you are not sure there is that much room, ask your host before you build it — a server that runs out of space mid-way takes the site down."
msgstr "ເຊີເວີນີ້ຈະບໍ່ບອກເຮົາວ່າປ່ອງຫວ່າງໃນດິສກ໌ເຫຼືອເທົ່າໃດ, ດັ່ງນັ້ນ ເຮົາຈຶ່ງບໍ່ສາມາດກວດສອບໃຫ້ທ່ານໄດ້. ແພັກເກດນີ້ຕ້ອງການພື້ນທີ່ປະມານ %s. ຖ້າທ່ານບໍ່ແນ່ໃຈວ່າມີພື້ນທີ່ພຽງພໍຫຼືບໍ່, ກະລຸນາສອບຖາມຜູ້ໃຫ້ບໍລິການໂຮດຕິ້ງຂອງທ່ານກ່ອນທີ່ທ່ານຈະສ້າງມັນ — ເພາະເຊີເວີທີ່ມີພື້ນທີ່ໝົດໃນລະຫວ່າງການດຳເນີນການຈະເຮັດໃຫ້ເວັບໄຊທ໌ຫຼົ່ມໄດ້."

#. translators: 1: space required, 2: space free.
#: includes/class-zinn-migrate-admin.php:197
#, php-format
msgid "The package needs roughly %1$s and this server has %2$s free."
msgstr "ຊຸດດັ່ງກ່າວຕ້ອງການເນື້ອທີ່ປະມານ %1$s ແລະ ເຊີບເວີນີ້ມີພື້ນທີ່ຫວ່າງ %2$s."

#: includes/class-zinn-migrate-admin.php:206
msgid "Build the package"
msgstr "ສ້າງແພັກເກັດ"

#: includes/class-zinn-migrate-admin.php:208
msgid "Building…"
msgstr "ກຳລັງສ້າງ…"

#. translators: 1: what is being packaged now, 2: files packaged so far, 3: size so far.
#: includes/class-zinn-migrate-admin.php:213
#, php-format
msgid "Now packaging: %1$s. %2$s files so far, %3$s written."
msgstr "ກຳລັງຫຸ້ມຫໍ່: %1$s. ຜ່ານມາ %2$s ໄຟລ໌, ຂຽນແລ້ວ %3$s."

#: includes/class-zinn-migrate-admin.php:214
msgid "your files"
msgstr "ໄຟລ໌ຂອງທ່ານ"

#: includes/class-zinn-migrate-admin.php:214
msgid "your database"
msgstr "ຖານຂໍ້ມູນຂອງທ່ານ"

#: includes/class-zinn-migrate-admin.php:226
msgid "Continue"
msgstr "ສືບຕໍ່"

#: includes/class-zinn-migrate-admin.php:227
msgid "Cancel and delete"
msgstr "ຍົກເລີກ ແລະ ລົບ"

#: includes/class-zinn-migrate-admin.php:238
msgid "Your package is ready"
msgstr "ຊຸດໂມດູນຂອງທ່ານພ້ອມແລ້ວ"

#: includes/class-zinn-migrate-admin.php:239
msgid "Copy this link and paste it into your migration on Zinn®:"
msgstr "ຄັດລອກລິ້ງນີ້ ແລະ ວາງລົງໃນການຍ້າຍຂໍ້ມູນຂອງທ່ານໃນ Zinn®:"

#. translators: %s: the package size.
#: includes/class-zinn-migrate-admin.php:252
#, php-format
msgid "Size: %s."
msgstr "ຂະໜາດ: %s."

#: includes/class-zinn-migrate-admin.php:264
msgid "Treat this link like a password. Anyone who has it can download your whole site, including your database. We delete the package automatically 24 hours after it was built — delete it yourself as soon as your migration has finished."
msgstr "ໃຫ້ຖືວ່າລິ້ງນີ້ເປັນລະຫັດຜ່ານ. ຜູ້ໃດກໍຕາມທີ່ມີມັນສາມາດດາວໂຫລດເວັບໄຊທ໌ທັງໝົດຂອງທ່ານໄດ້, ລວມທັງຖານຂໍ້ມູນຂອງທ່ານ. ພວກ​ເຮົາ​ລຶບ​ແພັກ​ເກັດ​ໂດຍ​ອັດ​ຕະ​ໂນ​ມັດ 24 ຊົ່ວ​ໂມງ​ຫຼັງ​ຈາກ​ທີ່​ມັນ​ຖືກ​ສ້າງ — ລຶບ​ມັນ​ດ້ວຍ​ຕົວ​ທ່ານ​ເອງ​ທັນ​ທີ​ທີ່​ການ​ຍ້າຍ​ຂໍ້ມູນ​ຂອງ​ທ່ານ​ສຳ​ເລັດ​ແລ້ວ."

#: includes/class-zinn-migrate-admin.php:273
msgid "Delete the package now"
msgstr "ລົບແພັກເກດຕອນນີ້"

#: includes/class-zinn-migrate-admin.php:274
msgid "Build it again"
msgstr "ສ້າງມັນຄືນໃໝ່"

#: includes/class-zinn-migrate-package.php:187
msgid "This server does not have PHP’s ZipArchive extension, so we cannot build a package here. Ask your host to enable it, or use the migration form on Zinn® with your FTP or SSH details instead."
msgstr "ເຊີບເວີນີ້ບໍ່ມີສ່ວນຂະຫຍາຍ ZipArchive ຂອງ PHP, ດັ່ງນັ້ນພວກເຮົາຈຶ່ງບໍ່ສາມາດສ້າງແພັກເກັດຢູ່ທີ່ນີ້ໄດ້. ກະລຸນາຂໍໃຫ້ໂຮສຂອງທ່ານເປີດໃຊ້ມັນ, ຫຼືໃຊ້ແບບຟອມການຍ້າຍຂໍ້ມູນໃນ Zinn® ໂດຍໃຊ້ລາຍລະອຽດ FTP ຫຼື SSH ຂອງທ່ານແທນ."

#: includes/class-zinn-migrate-package.php:197
msgid "We could not create a folder inside your uploads directory, so there is nowhere to write the package. Check that wp-content/uploads is writable."
msgstr "ພວກເຮົາບໍ່ສາມາດສ້າງໂຟນເດີພາຍໃນໄດເລກະທໍລີການອັບໂຫລດຂອງທ່ານໄດ້, ດັ່ງນັ້ນຈຶ່ງບໍ່ມີບ່ອນຂຽນແພັກເກດ. ກະລຸນາ ກວດສອບວ່າ wp-content/uploads ສາມາດຂຽນໄດ້."

#: includes/class-zinn-migrate-package.php:278
msgid "There is no package being built. Start one first."
msgstr "ບໍ່ມີແພັກເກດທີ່ກຳລັງສ້າງ. ກະລຸນາເລີ່ມຕົ້ນໜຶ່ງອັນກ່ອນ."

#: includes/class-zinn-migrate-package.php:284
msgid "We could not open the package file for writing."
msgstr "ພວກເຮົາບໍ່ສາມາດເປີດໄຟລ໌ແພັກເກັດເພື່ອຂຽນໄດ້."

#: includes/class-zinn-migrate-package.php:366
msgid "We could not write the database export."
msgstr "ພວກເຮົາບໍ່ສາມາດຂຽນການສົ່ງອອກຖານຂໍ້ມູນໄດ້."

#. translators: %s: the Zinn Digital trade mark, which is not translated.
